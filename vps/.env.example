# Copy to .env and fill in: cp .env.example .env
# .env is gitignored; keep your real domain and keys out of the repo.

# Required. Site REALITY borrows its TLS handshake from. It must support
# TLS 1.3 + h2 and must NOT be blocked in China: the SNI is sent in clear
# text and blocked names get reset. Test from a China network with
# `curl https://<site>/`. Prefer names few proxies use; avoid www.apple.com,
# www.microsoft.com and the like. See README.
REALITY_SNI=

# Optional second REALITY inbound with its own site. Clients get a second
# link; put both in a fallback/urltest group and they switch over by
# themselves if REALITY_SNI's site goes down. Empty: one inbound only.
REALITY_SNI_B=

# Ports. Empty means: REALITY 443 (8443 with derper), REALITY_B 8443 (9443 with derper).
REALITY_PORT=
REALITY_PORT_B=

# Hysteria2 (QUIC/UDP). Off by default: heavy UDP to one IP is easy to spot
# and gets throttled, and if it gets the IP blocked REALITY goes with it.
HY2_ENABLED=false
HY2_PORT=443
# Name in the self-signed Hysteria2 cert and the site shown to probes.
HY2_SNI=www.bing.com

# Tailscale DERP relay. Leave empty to skip derper on this VPS: one or two
# near your devices are enough. When set, point its A record at this VPS;
# derper gets a Let's Encrypt cert for it and needs TAILSCALE=true.
# Better kept off your proxy VPS: relayed traffic adds to what that IP carries.
DERP_DOMAIN=
DERP_STUN_PORT=3478
# Tailscale region ID for this derper, 900-999. Give each derper its own so
# clients can pick the nearest one.
DERP_REGION_ID=900

# Join this VPS to your tailnet (true/false). Also handy for SSH over tailnet.
TAILSCALE=true

# Optional Tailscale auth key (https://login.tailscale.com/admin/settings/keys).
# Empty: an interactive run prints a login URL instead.
TS_AUTHKEY=

# Address used in client links (an IPv4 or a domain). Detected automatically
# if empty. A public IPv6, if the VPS has one, gets its own links too.
PUBLIC_IP=
